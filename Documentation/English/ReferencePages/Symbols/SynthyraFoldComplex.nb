Notebook[{

Cell[CellGroupData[{
Cell["SynthyraFoldComplex", "ObjectName",
 CellID->965289630,ExpressionUUID->"3ce5a1f3-df23-de4e-be19-00e0b9eb2cf6"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraFoldComplex", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", "p2", ",", "..."}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"88070f9e-9cd9-f84b-9524-4a558d01fc5e"],
 " predicts the structure of a complex of protein chains. The \"Ligands\" \
option adds small molecules."
}], "Usage",
 CellID->149060535,ExpressionUUID->"1eda1ad4-5f9e-cf4d-a9e5-b4098fa3722e"],

Cell["Details", "NotesSection",
 CellID->160327026,ExpressionUUID->"5584b09d-6b97-dc4b-9549-65ea0c3ef188"],

Cell["\<\
Chains are lettered A, B, C, ... in the order given; the result is one \
BioMolecule.\
\>", "Notes",
 CellID->100417531,ExpressionUUID->"03b61eb9-2d9c-9645-915c-7412cf7ca443"],

Cell["\<\
With \"Output\" -> \"Association\", \"IPTM\" is the model's confidence in the \
interfaces between chains.\
\>", "Notes",
 CellID->136025588,ExpressionUUID->"c6b883d9-6768-f941-925c-ad741b529a0f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellID->933175874,ExpressionUUID->"23826b0d-d285-d14e-bbfb-86f47a801b43"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Synthyra`SynthyraLink`\>\"", "]"}]], "Input",
 CellID->420424847,ExpressionUUID->"e14f989b-004a-6e45-80ed-a88ffc4f33d8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"complex", "=", 
   RowBox[{"SynthyraFoldComplex", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<SUMO1\>\"", ",", "\"\<UBE2I\>\""}], "}"}], ",", 
     RowBox[{"\"\<Output\>\"", "->", "\"\<Association\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"complex", "[", 
  RowBox[{"[", 
   RowBox[{"{", 
    RowBox[{"\"\<MeanPLDDT\>\"", ",", "\"\<PTM\>\"", ",", "\"\<IPTM\>\""}], 
    "}"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->100213815,ExpressionUUID->"25cae9b4-da3f-0444-ac7a-45a159a48794"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"MeanPLDDT\"\>", "\[Rule]", "81.9776713848114`"}], ",", 
   RowBox[{"\<\"PTM\"\>", "\[Rule]", "0.728330671787262`"}], ",", 
   RowBox[{"\<\"IPTM\"\>", "\[Rule]", "0.4596155285835266`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]=",
 CellID->461750203,ExpressionUUID->"bdccfaac-562f-fe4e-a850-795a476e1c7c"]
}, Open  ]],

