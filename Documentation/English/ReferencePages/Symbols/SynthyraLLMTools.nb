Notebook[{

Cell[CellGroupData[{
Cell["SynthyraLLMTools", "ObjectName",
 CellID->1789269148,ExpressionUUID->"aafde532-f773-a94f-8882-d08d37267fd5"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraLLMTools", "[", "]"}]], "InlineFormula",ExpressionUUID->
  "07f8dc37-3887-ed48-b9c8-75ca48b9440c"],
 " gives LLMTool objects for protein interaction, ligand binding, properties, \
interaction partners, and folding, for use with LLMSynthesize and ChatObject."
}], "Usage",ExpressionUUID->"079c1bf9-705c-f14d-9ba1-c0ffd34b080a"],

Cell["Details", "NotesSection",
 CellID->526220353,ExpressionUUID->"b7dbedb6-a5d4-f141-88f8-832ad94b4e5b"],

Cell["\<\
Each tool takes proteins as UniProt accessions, gene symbols, or sequences \
and returns text a language model reads.\
\>", "Notes",
 CellID->176100681,ExpressionUUID->"55cccab3-c012-6146-bc82-24d1bfade5b6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"85d7a6a4-fbbf-104e-8775-da6908927958"],

