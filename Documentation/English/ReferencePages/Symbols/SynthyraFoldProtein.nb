Notebook[{

Cell[CellGroupData[{
Cell["SynthyraFoldProtein", "ObjectName",ExpressionUUID->"383f2a99-a1bc-2246-a4e1-50aaf3026cae"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraFoldProtein", "[", "protein", "]"}]], "InlineFormula",
  ExpressionUUID->"530ad01a-c0b6-304a-992a-dccef2a9cb05"],
 " predicts the structure of a protein with ESMFold2 and returns a \
BioMolecule whose B-factors hold per-atom confidence."
}], "Usage",ExpressionUUID->"57a64766-11ed-d344-8cd6-7f53bbaf7027"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraFoldProtein", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", "p2", ",", "..."}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"2e23d24b-1547-0843-8759-9d027c6efd51"],
 " folds several proteins in one job."
}], "Usage",
 CellID->166261922,ExpressionUUID->"474bc72c-dab8-4445-b43e-7bb9652fd059"],

Cell["Details", "NotesSection",
 CellID->476258440,ExpressionUUID->"1792c477-4c8c-7f46-b9e8-4d2c9aeedaf7"],

Cell["\<\
Structures are predicted by ESMFold2 through Synthyra's batch fold service; \
several proteins fold in one job.\
\>", "Notes",
 CellID->138926855,ExpressionUUID->"f326bcda-a6fe-b74e-be79-c607f9c2bccb"],

Cell["\<\
Each atom's B-factor holds the model's confidence, pLDDT, on a 0 to 1 scale; \
SynthyraStructurePlot colors by it.\
\>", "Notes",
 CellID->689986683,ExpressionUUID->"52eb570a-0fa6-9d48-b305-c0cf9927b201"],

Cell["\<\
\"Output\" -> \"Association\" also gives the model, mean pLDDT from 0 to 100, \
pTM, per-residue pLDDT by chain, and the PDB text.\
\>", "Notes",
 CellID->94877139,ExpressionUUID->"ce0e31f4-9da4-ec41-9ce9-d50b6d9d756a"],

Cell["\<\
\"Model\" selects a served ESMFold2 model and \"Seed\" fixes the sampling \
seed.\
\>", "Notes",
 CellID->1498143501,ExpressionUUID->"510bb95e-e375-6a49-835f-3e8afdd12415"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellID->21165559,ExpressionUUID->"7bfafe58-5e9f-e948-8e1f-ea7a71c2b3fa"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Synthyra`SynthyraLink`\>\"", "]"}]], "Input",
 CellID->33680014,ExpressionUUID->"5e578fe1-24da-3847-9585-82274c3e7be0"],

