Cell[CellGroupData[{
Cell["SynthyraProteinProperties", "ObjectName",ExpressionUUID->"b69fd71b-d681-3d4f-a7c1-768416ad3bfc"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraProteinProperties", "[", "protein", "]"}]], 
  "InlineFormula",ExpressionUUID->"3aa4d1de-1104-fa4e-8751-0bd3d270acc3"],
 " gives a Dataset of the properties Synthyra's Oracle probes predict for a \
protein."
}], "Usage",
 CellID->1052282135,ExpressionUUID->"08d86bdb-9823-a043-b81a-12236e2cf248"],

Cell["Details", "NotesSection",
 CellID->8629379,ExpressionUUID->"e262765d-b145-6a4f-b555-208f61cc2ef8"],

Cell["\<\
Each row is one Oracle probe. A classifier's \"Prediction\" is its most \
likely label with that label's \"Probability\", and \"Labels\" lists the \
leading labels; a regressor's \"Prediction\" is its value.\
\>", "Notes",
 CellID->1853132081,ExpressionUUID->"0b3b69c0-5d5c-f447-b2ed-35c88dfd2c00"],

Cell["\<\
Oracles read the sequence alone, so they apply to designed and unannotated \
proteins as well.\
\>", "Notes",
 CellID->1801720886,ExpressionUUID->"2d30d122-1b05-c545-bd0d-f8c2b6f03459"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",ExpressionUUID->"df0a3448-25f7-5848-859a-879b4cb5b01f"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Synthyra`SynthyraLink`\>\"", "]"}]], "Input",
 CellID->1143232178,ExpressionUUID->"a0fc2d98-3beb-2d4b-a6c6-bd20eae2c80b"],

