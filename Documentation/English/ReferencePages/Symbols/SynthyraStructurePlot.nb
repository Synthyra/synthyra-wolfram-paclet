Notebook[{

Cell[CellGroupData[{
Cell["SynthyraStructurePlot", "ObjectName",
 CellID->847068762,ExpressionUUID->"5e7c4538-04f1-734f-a111-140da14091ad"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraStructurePlot", "[", "molecule", "]"}]], "InlineFormula",
  ExpressionUUID->"b4c62570-8bd1-d640-ab6a-152d482e92d4"],
 " renders a BioMolecule with BioMoleculePlot3D, colored by per-residue \
prediction confidence (pLDDT)."
}], "Usage",
 CellID->2028608987,ExpressionUUID->"4ec77c66-7060-d441-b004-e5d06c082f47"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraStructurePlot", "[", 
   RowBox[{"molecule", ",", 
    RowBox[{"\<\"ColorBy\"\>", "->", "values"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"ff8332e2-cd2d-3840-8825-51c71bd02d8e"],
 " colors residues by a list of values, or an Association of lists by chain."
}], "Usage",
 CellID->62779769,ExpressionUUID->"fd54b82e-b14f-5445-bf13-d1fdf02ca153"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraStructurePlot", "[", "analysis", "]"}]], "InlineFormula",
  ExpressionUUID->"c3973c29-8348-384e-9a2f-e2c69c11cb5d"],
 " plots the structure in a coordinated analysis result."
}], "Usage",
 CellID->1312440973,ExpressionUUID->"2d7a2eba-3dfc-8244-a646-1f44876e7e3f"],

Cell["Details", "NotesSection",
 CellID->247615129,ExpressionUUID->"ac48c466-ee0e-b34d-a787-dda7968fb411"],

Cell["\<\
\"ColorBy\" -> \"Confidence\", the default, colors residues in the pLDDT \
bands AlphaFold and ESMFold report: above 90, 70 to 90, 50 to 70, and below \
50.\
\>", "Notes",
 CellID->340403531,ExpressionUUID->"a7f0d05a-19b1-df46-8e32-4675505d4dce"],

Cell["\<\
\"ColorBy\" -> values takes one number per residue, and an Association of \
lists by chain for a complex; \"Chain\" and None use BioMoleculePlot3D's own \
coloring.\
\>", "Notes",
 CellID->350560923,ExpressionUUID->"0c1320e3-3a1a-2c42-8c0e-0ebe29561bf9"],

Cell["\<\
Any BioMolecule works, including those from ImportString[pdb, \"PDB\"] and \
BioMoleculeData.\
\>", "Notes",
 CellID->698161872,ExpressionUUID->"58bd726b-81c7-9746-9f5d-d8e61d1342c8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellID->209230632,ExpressionUUID->"e96cadff-b0c1-6e4b-863f-f2eb90a54554"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Synthyra`SynthyraLink`\>\"", "]"}]], "Input",
 CellID->162538257,ExpressionUUID->"5fe8eb8d-f3c3-2d4a-91a8-1ca2c6975171"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sumo1", "=", 
   RowBox[{"SynthyraFoldProtein", "[", "\"\<SUMO1\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"SynthyraStructurePlot", "[", "sumo1", "]"}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->84337190,ExpressionUUID->"acb65d4c-36f2-ae4e-84b7-67b87505b8ea"],

