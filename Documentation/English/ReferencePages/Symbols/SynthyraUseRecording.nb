Notebook[{

Cell[CellGroupData[{
Cell["SynthyraUseRecording", "ObjectName",
 CellID->1461904488,ExpressionUUID->"abb7b635-7ac4-5d49-b1e4-72ef9b3d7371"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraUseRecording", "[", "file", "]"}]], "InlineFormula",
  ExpressionUUID->"525c3756-d9b0-7546-b27a-3b1a4238ad73"],
 " answers every Synthyra, UniProt, and PubChem request from a recording made \
by SynthyraRecord, so a session runs offline. SynthyraUseRecording[\"TP53Demo\
\"] uses the recording of the TP53 demo notebook that ships with the paclet. \
SynthyraUseRecording[None] returns to the network."
}], "Usage",ExpressionUUID->"e3782017-cb3d-2945-9d09-c3bef2b8fa64"],

Cell["Details", "NotesSection",ExpressionUUID->"a50f1cd2-f963-4b47-bb95-8bca4dc3c3c2"],

Cell["\<\
A request made more than once replays its responses in order, then repeats \
the last; a request the recording lacks gives a \"NotRecorded\" Failure.\
\>", "Notes",ExpressionUUID->"ed85ce50-b847-be40-a487-445945f64dae"],

Cell["\<\
With no client connected, replay creates one that needs no key.\
\>", "Notes",
 CellID->2010347953,ExpressionUUID->"28054369-5d79-b94d-87c2-43ff825d7600"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellID->1239554109,ExpressionUUID->"ea6d8017-00af-9745-b101-13ae13a68b9e"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Synthyra`SynthyraLink`\>\"", "]"}]], "Input",Expre\
ssionUUID->"b002d625-a2b9-1a43-b18a-df5e884c7bb4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SynthyraUseRecording", "[", "\"\<TP53Demo\>\"", "]"}], ";"}], "\n", 
 RowBox[{"SynthyraProteinInteractionScore", "[", 
  RowBox[{"\"\<TP53\>\"", ",", 
   RowBox[{"\"\<MDM2\>\"", "->", "\"\<Q00987\>\""}]}], "]"}]}], "Input",
 CellID->181542964,ExpressionUUID->"feb31165-3420-9a4b-88b1-5d533e571492"],

Cell[BoxData[
 RowBox[{"SynthyraUseRecording", "[", "None", "]"}]], "Input",
 CellID->1103177211,ExpressionUUID->"668aedec-6bdf-cd4f-b7ee-691ff843af17"]
}, Open  ]],

Cell[CellGroupData[{

