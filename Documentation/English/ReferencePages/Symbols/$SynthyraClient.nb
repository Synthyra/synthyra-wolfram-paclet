Notebook[{

Cell[CellGroupData[{
Cell["$SynthyraClient", "ObjectName",ExpressionUUID->"b06748a7-e51b-e941-af8b-0c44dae87c80"],

Cell["\<\
$SynthyraClient is the client Synthyra functions use when \"Client\" -> \
Automatic; SynthyraConnect sets it.\
\>", "Usage",ExpressionUUID->"5e6e3f20-e79a-0d4b-b517-7fce2c0511e9"],

Cell["Details", "NotesSection",ExpressionUUID->"377912ac-722e-364f-8f66-a4d517e4d0a8"],

Cell["\<\
Every function with a \"Client\" option uses $SynthyraClient when the option \
is Automatic, and calls SynthyraConnect[] when it is None.\
\>", "Notes",
 CellID->1928692391,ExpressionUUID->"9daa8fae-68fa-ec4c-924f-f36491c357c8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellID->1789568961,ExpressionUUID->"dbc61dfa-3939-5147-b21c-3b0efa864943"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Synthyra`SynthyraLink`\>\"", "]"}]], "Input",Expre\
ssionUUID->"6fdb5edf-e420-9846-9b90-6fd335a79865"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SynthyraConnect", "[", "]"}], ";", "$SynthyraClient"}]], "Input",
 CellID->1,ExpressionUUID->"b5b1b3c7-0033-d542-8024-3ed8984dcb33"]
}, Open  ]],

