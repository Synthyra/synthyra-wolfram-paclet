Notebook[{

Cell[CellGroupData[{
Cell["SynthyraConnect", "ObjectName",
 CellID->1086102420,ExpressionUUID->"414e2c78-ff80-ea48-a60a-a39933dcc566"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraConnect", "[", "]"}]], "InlineFormula",ExpressionUUID->
  "61ced024-1e82-1c43-b938-f58f631a8371"],
 " creates a production Synthyra client. SynthyraConnect[\"Development\"] \
creates a development client."
}], "Usage",
 CellID->1532534813,ExpressionUUID->"5e2f0343-59bc-444e-8841-cfd23d9a096d"],

Cell["Details", "NotesSection",
 CellID->32,ExpressionUUID->"a9c10652-cf62-4e43-a2f9-896b0b81db16"],

Cell["\<\
The API key comes from the Authentication option, then the SYNTHYRA_API_KEY \
environment variable, then SystemCredential[\"Synthyra/APIKey\"], then a \
dialog in a notebook.\
\>", "Notes",
 CellID->787786794,ExpressionUUID->"d780cd49-1f7e-af4c-ab14-f4f1c297ea9a"],

Cell["\<\
The client holds a handle to the key, never the key itself, so it is safe to \
display, save, or share.\
\>", "Notes",
 CellID->1871102213,ExpressionUUID->"1edb3485-9b72-8e4c-b81e-daef7a0dc5bb"],

Cell["\<\
SynthyraConnect sets $SynthyraClient, which every Synthyra function uses by \
default.\
\>", "Notes",
 CellID->1736823806,ExpressionUUID->"4b77f87d-0291-d841-8799-343fd4e32c69"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellID->1368661572,ExpressionUUID->"e863d2c6-446d-1042-8012-2aba755832e5"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Synthyra`SynthyraLink`\>\"", "]"}]], "Input",
 CellID->106549707,ExpressionUUID->"1b743e7e-7692-1747-a281-8d0ae0643682"],

Cell[BoxData[
 RowBox[{"SynthyraConnect", "[", "]"}]], "Input",
 CellID->306617567,ExpressionUUID->"de6adaa8-2a02-d342-8a1e-196983b979f5"],

Cell[BoxData[
 RowBox[{"SynthyraConnect", "[", "\"\<Development\>\"", "]"}]], "Input",
 CellID->752594807,ExpressionUUID->"914de90c-36e1-5a48-8037-751dd3434bc1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SystemCredential", "[", "\"\<Synthyra/APIKey\>\"", "]"}], 
   "=", "\"\<your key\>\""}], ";"}]], "Input",
 CellID->1163590711,ExpressionUUID->"33436136-d1cd-a348-a814-29b0c170dfc5"]
}, Open  ]],

Cell[CellGroupData[{

