Notebook[{

Cell[CellGroupData[{
Cell["SynthyraProteinSequence", "ObjectName",
 CellID->1386967012,ExpressionUUID->"224b7c68-f099-cd4b-9d01-203d546be0f3"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraProteinSequence", "[", "protein", "]"}]], "InlineFormula",
  ExpressionUUID->"337bf13b-f204-194d-8943-b28032b448c2"],
 " gives the BioSequence of a UniProt accession, gene symbol, \
Entity[\"Protein\", ...], or sequence."
}], "Usage",ExpressionUUID->"189d9007-08c7-3848-b71a-4f8d2a287904"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraProteinSequence", "[", 
   RowBox[{"{", 
    RowBox[{"p1", ",", "p2", ",", "..."}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"00f4ce74-5665-274c-b76d-8056670c8972"],
 " gives an Association of them."
}], "Usage",
 CellID->472199,ExpressionUUID->"327fe114-ff17-1448-9594-c5fd1aade65b"],

Cell["Details", "NotesSection",
 CellID->353007806,ExpressionUUID->"724419ee-6fc5-d044-9e09-d64cd554cec4"],

Cell["\<\
A protein may be an amino-acid string, a peptide BioSequence, a UniProt \
accession, a gene symbol, an Entity[\"Protein\", ...], or a BioMolecule.\
\>", "Notes",
 CellID->550711255,ExpressionUUID->"0828c685-2909-ae47-92f3-8b0ce8075787"],

Cell["\<\
A gene symbol resolves to the reviewed UniProt entry of the organism the \
\"Organism\" option names, human by default. Strings shorter than 10 residues \
are read as gene symbols; wrap a short peptide in BioSequence.\
\>", "Notes",
 CellID->3617933,ExpressionUUID->"c7e189a3-1154-1d49-b23c-ac659067c12a"],

Cell["\<\
label -> protein sets the key a result carries. Lookups are cached for the \
session.\
\>", "Notes",
 CellID->610152980,ExpressionUUID->"40c80c80-d4e9-7046-8604-c6c24e113aed"]
}, Open  ]],

