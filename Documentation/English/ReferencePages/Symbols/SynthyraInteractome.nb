(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["SynthyraInteractome", "ObjectName",
 CellID->1147545688,ExpressionUUID->"791b4044-e697-a040-be7c-29e30fe819e7"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraInteractome", "[", "protein", "]"}]], "InlineFormula",
  ExpressionUUID->"c39c286c-34af-714b-b159-a20288815e88"],
 " gives the Graph of a protein's predicted interaction partners across its \
organism's proteome, with Atlas confidence on each edge and the partners' \
functional enrichment as the \"Enrichment\" annotation."
}], "Usage",ExpressionUUID->"a3fdb137-8a31-4049-9b46-506c306fd8fb"],

Cell["Details", "NotesSection",ExpressionUUID->"f9c9d9a6-4eca-e543-b6b9-07faff8defe7"],

Cell["\<\
Vertices are gene symbols. Each edge carries \"Confidence\" from 0 to 100 as \
an annotation and as EdgeWeight from 0 to 1, and \"BioGRID\", \"STRING\", and \
\"Novel\" say whether the interaction is already recorded.\
\>", "Notes",
 CellID->1806099196,ExpressionUUID->"84a8cbdd-0a1a-c342-b023-dea8f05180b4"],

Cell["\<\
The graph's \"Enrichment\" annotation is a Dataset of the enriched terms of \
the neighborhood, with each adjusted p-value as its base-10 logarithm.\
\>", "Notes",
 CellID->171598595,ExpressionUUID->"62ba0837-5226-7b44-9d16-4728d3a85ef0"],

Cell["\<\
\"Neighbors\", \"Threshold\", and \"NeighborDepth\" bound the partners kept; \
organisms are human, mouse, yeast, E. coli, fruit fly, C. elegans, and \
Arabidopsis. A job takes a few minutes.\
\>", "Notes",ExpressionUUID->"a1bfee35-48af-ad44-b132-2243d589a36c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples", "PrimaryExamplesSection",
 CellID->524066309,ExpressionUUID->"d43a98fd-be2e-2848-8bfb-74ceef8f6900"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Synthyra`SynthyraLink`\>\"", "]"}]], "Input",Expre\
ssionUUID->"8f95f48d-cde3-3f46-bad1-d923e9662b04"],

Cell[CellGroupData[{

