  "e6e671fa-a26b-0540-8a30-bc911a1f8afd"],
 " gives the Atlas probability, from 0 to 1, that proteins a and b physically \
interact."
}], "Usage",ExpressionUUID->"21b703be-1fbb-b442-b620-8719a122c7df"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraProteinInteractionScore", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a1", ",", "..."}], "}"}], ",", 
    RowBox[{"{", 
