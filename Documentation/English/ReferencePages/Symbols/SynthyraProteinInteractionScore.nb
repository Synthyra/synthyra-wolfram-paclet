Cell["Details", "NotesSection",
 CellID->109899764,ExpressionUUID->"e9084e4e-8699-2e47-89a3-342a7503e817"],

Cell["\<\
The score is Atlas-PPI's probability that the two proteins physically \
interact.\
\>", "Notes",
 CellID->471515695,ExpressionUUID->"0ee0fb6c-d020-4d4e-9731-79e1a4c615c1"],

Cell["\<\
Lists or Associations give every pair as a Dataset, rows from the first \
argument and columns from the second; large sets are sent in several requests.\
\>", "Notes",
 CellID->291274170,ExpressionUUID->"0c9da38b-1623-a54c-b384-54d46f6736d1"]
}, Open  ]],

