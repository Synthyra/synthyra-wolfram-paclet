Notebook[{

Cell[CellGroupData[{
Cell["SynthyraRecord", "ObjectName",
 CellID->790092271,ExpressionUUID->"94f8f894-faf4-5e4c-9799-2bb3c0db272c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"SynthyraRecord", "[", 
   RowBox[{"expr", ",", "file"}], "]"}]], "InlineFormula",ExpressionUUID->
  "4804236b-16b0-874c-be12-3c7ade5c1013"],
 " evaluates expr and saves every HTTP exchange it makes to file, without \
request headers or credentials, for SynthyraUseRecording."
}], "Usage",
 CellID->147376522,ExpressionUUID->"0fd8e8dc-02d6-e04e-a5fb-6b719f7c34b1"],

Cell["Details", "NotesSection",
 CellID->1881172181,ExpressionUUID->"a7d86432-3324-2a4d-ae85-ea871bb6ae23"],

Cell["\<\
A recording holds each request's method, URL, and body and each response, \
never a request header, so it holds no credential.\
\>", "Notes",
 CellID->524754324,ExpressionUUID->"127ec8b0-b5cf-234b-8f4d-fb275550994a"]
}, Open  ]],

