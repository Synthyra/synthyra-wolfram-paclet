Notebook[{
Cell["TP53 with Synthyra", "TechNoteTitle",ExpressionUUID->"02af5f89-7a42-d649-a1a0-12387a54a52b"],

Cell["\<\
Structure, properties, interactions, and ligands of the tumor suppressor p53, \
from the Wolfram Language\
\>", "TechNoteText",ExpressionUUID->"32b8f752-bd35-4046-9f49-711aa072c6d2"],

Cell["\<\
Each function below calls Synthyra's production API with the key in \
SYNTHYRA_API_KEY or SystemCredential[\"Synthyra/APIKey\"]. To run without a \
network or a key, evaluate the offline cell in place of the connect cell: it \
answers every request from a recording of this notebook made against \
production on 2026-09-29.\
\>", "TechNoteText",ExpressionUUID->"6d4df34a-4ab0-1942-a093-a56e7ea37357"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<Synthyra`SynthyraLink`\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"6ff656bc-9966-9a40-a72f-1c55bbec11b1"],

Cell[BoxData[
 RowBox[{"SynthyraConnect", "[", "]"}]], "Input",ExpressionUUID->"700ad847-a695-d44c-9e0f-e7db23f13e38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SynthyraUseRecording", "[", "\"\<TP53Demo\>\"", "]"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"c0743bd1-a5c6-f940-a542-7a72d7f22028"],

Cell[BoxData["\<\"TP53Demo\"\>"], "Output",
 CellLabel->"Out[2]=",ExpressionUUID->"f516319f-fc19-ed4f-9080-41629afc0912"]
}, Open  ]],

Cell["The protein", "TechNoteSection",ExpressionUUID->"4f4c1b87-b919-bd46-b26a-2be1943b0d27"],

Cell["\<\
A gene symbol, UniProt accession, Entity[\"Protein\", ...], or sequence all \
name a protein. Gene symbols resolve to the reviewed human UniProt entry \
unless \"Organism\" says otherwise.\
\>", "TechNoteText",ExpressionUUID->"01104f64-d805-ec47-8f22-31b773661ebc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tp53", "=", 
  RowBox[{"SynthyraProteinSequence", "[", "\"\<TP53\>\"", "]"}]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"d0c87cff-68df-e648-8efc-b69349696c40"],

