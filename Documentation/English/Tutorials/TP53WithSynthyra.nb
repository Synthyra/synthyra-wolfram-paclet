         RowBox[{
          RowBox[{"{", 
           RowBox[{"net", ",", 
            RowBox[{"First", "@", 
             RowBox[{"EdgeList", "[", 
              RowBox[{"net", ",", 
               RowBox[{"\"\<TP53\>\"", "\[UndirectedEdge]", "#"}]}], 
              "]"}]}]}], "}"}], ",", "\"\<Confidence\>\""}], "]"}], "&"}], ",", 
       RowBox[{"AdjacencyList", "[", 
        RowBox[{"net", ",", "\"\<TP53\>\""}], "]"}]}], "]"}], ",", "8"}], 
    "]"}]}]}]], "Input",
