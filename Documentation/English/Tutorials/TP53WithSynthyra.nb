        RowBox[{"BioSequence", "[", 
         RowBox[{"\"\<Peptide\>\"", ",", 
          RowBox[{"StringTake", "[", 
           RowBox[{
            RowBox[{"mdm2", "[", "\"\<SequenceString\>\"", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"17", ",", "125"}], "}"}]}], "]"}]}], "]"}]}], ",", 
       RowBox[{"\"\<p53 transactivation helix\>\"", "->", 
        RowBox[{"BioSequence", "[", 
