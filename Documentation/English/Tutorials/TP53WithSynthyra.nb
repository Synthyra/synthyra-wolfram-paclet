Cell["\<\
Each edge also says whether BioGRID or STRING already records the \
interaction. These are the predicted partners that are known:\
\>", "TechNoteText",ExpressionUUID->"da282d28-64b1-624e-904e-f745d5c403c4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{"EdgeList", "[", 
    RowBox[{"net", ",", 
     RowBox[{"\"\<TP53\>\"", "\[UndirectedEdge]", "_"}]}], "]"}], ",", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"TrueQ", "[", 
      RowBox[{"AnnotationValue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"net", ",", "#"}], "}"}], ",", "\"\<Novel\>\""}], "]"}], 
      "]"}]}], "&"}]}], "]"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"805bbf0f-35db-2b4c-972e-f77d7592b036"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"TRIM8\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"ZBED4\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"USP11\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"RELB\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"PIAS3\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"TRAF6\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"ZNF629\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"MDM4\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"HR\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"CHEK2\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"NFKB2\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"SUMO2\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"BCL6\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"SUMO1\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"ZMYM6\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"PARP10\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"REL\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"KDM4E\"\>"}], ",", 
   RowBox[{"\<\"TP53\"\>", "\[UndirectedEdge]", "\<\"PML\"\>"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[10]=",ExpressionUUID->"b81b5d31-c903-7046-bd88-132cabdf7377"]
}, Open  ]],

Cell["\<\
Almost every pair among these proteins scores above the threshold, so the \
whole network is close to complete. Its structure shows once only the most \
confident edges remain.\
\>", "TechNoteText",ExpressionUUID->"d836e294-1490-a043-88b1-ba9d99609d93"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"core", "=", 
   RowBox[{"EdgeDelete", "[", 
    RowBox[{"net", ",", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"EdgeList", "[", "net", "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"AnnotationValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"net", ",", "#"}], "}"}], ",", "\"\<Confidence\>\""}], 
          "]"}], "<", "94"}], "&"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"CommunityGraphPlot", "[", 
  RowBox[{"core", ",", 
   RowBox[{"FindGraphCommunities", "[", "core", "]"}], ",", 
   RowBox[{"VertexLabels", "->", "Automatic"}], ",", 
   RowBox[{"ImageSize", "->", "700"}]}], "]"}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"c4e92e74-84a8-ca4f-9c18-484d9d537456"],

