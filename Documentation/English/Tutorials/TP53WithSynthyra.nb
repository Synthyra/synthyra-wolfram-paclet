Cell["Ask in plain language", "TechNoteSection",ExpressionUUID->"a15797db-c4f1-c44e-be7a-f326f9b5f3ff"],

Cell["\<\
SynthyraLLMTools gives a language model the functions above. This cell needs \
an LLM service configured in Wolfram and is not part of the offline recording.\
\>", "TechNoteText",ExpressionUUID->"359e631f-8b75-2345-90c0-edccd298563b"],

Cell[BoxData[
 RowBox[{"LLMSynthesize", "[", 
  RowBox[{"\"\<Which proteins does TP53 interact with most strongly, and how \
confident is its predicted structure?\>\"", ",", 
   RowBox[{"LLMEvaluator", "->", 
    RowBox[{"<|", 
     RowBox[{"\"\<Tools\>\"", "->", 
      RowBox[{"SynthyraLLMTools", "[", "]"}]}], "|>"}]}]}], "]"}]], "Input",Ex\
pressionUUID->"63692650-6a09-cb4a-a757-8eeba496b9e3"]
},
