Cell["Structure", "TechNoteSection",ExpressionUUID->"2bca72be-8b0a-0443-88d7-e20617d4e651"],

Cell["\<\
ESMFold2 predicts the structure, and every residue carries its confidence, \
pLDDT, from 0 to 100. The DNA-binding core, residues 94 to 292, folds with \
high confidence; the transactivation domain and the C-terminal region are \
intrinsically disordered, as they are in the cell.\
\>", "TechNoteText",ExpressionUUID->"52998042-0658-9f47-ad3e-ece4829478ee"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fold", "=", 
   RowBox[{"SynthyraFoldProtein", "[", 
    RowBox[{"\"\<TP53\>\"", ",", 
     RowBox[{"\"\<Output\>\"", "->", "\"\<Association\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"fold", "[", 
  RowBox[{"[", 
   RowBox[{"{", 
    RowBox[{"\"\<Model\>\"", ",", "\"\<MeanPLDDT\>\"", ",", "\"\<PTM\>\""}], 
    "}"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"e8e4e9d2-ba13-0b4a-bc0e-8ba7556b0758"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Model\"\>", "\[Rule]", "\<\"Synthyra/ESMFold2-Fast\"\>"}], ",", 
   RowBox[{"\<\"MeanPLDDT\"\>", "\[Rule]", "79.68287467956543`"}], ",", 
   RowBox[{"\<\"PTM\"\>", "\[Rule]", "0.5494727492332458`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[5]=",ExpressionUUID->"b915c57d-69a9-3240-aed7-b291e4afa829"]
}, Open  ]],

