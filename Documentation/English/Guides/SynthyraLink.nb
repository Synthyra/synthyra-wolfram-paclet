Notebook[{

Cell[CellGroupData[{
Cell["SynthyraLink", "GuideTitle",
 CellID->451890487,ExpressionUUID->"ccc1b0e1-f0b8-d646-baba-37a94a815aaa"],

Cell["\<\
SynthyraLink brings Synthyra's protein models into the Wolfram Language: \
structures as BioMolecule objects, interaction networks as Graph objects, and \
predictions as Dataset objects, from a gene symbol, a UniProt accession, or a \
sequence.\
\>", "GuideAbstract",
 CellID->1187372976,ExpressionUUID->"fb5d23cf-d2e6-114b-8a39-10a9be417cbf"],

Cell[CellGroupData[{

Cell["Proteins and structures", "GuideFunctionsSubsection",
 CellID->174103173,ExpressionUUID->"de77b6cb-ef42-a14c-9f8e-bbb8bad8dc5f"],

Cell[TextData[{
 ButtonBox["SynthyraProteinSequence",
  BaseStyle->"Link",
  ButtonData->"paclet:Synthyra/SynthyraLink/ref/SynthyraProteinSequence"],
 " \[LongDash] a protein from a gene symbol, UniProt accession, entity, or \
sequence"
}], "GuideText",
 CellID->169826056,ExpressionUUID->"e266535b-ff2f-a846-9a8c-a53e28d6c4e4"],

Cell[TextData[{
 ButtonBox["SynthyraFoldProtein",
  BaseStyle->"Link",
  ButtonData->"paclet:Synthyra/SynthyraLink/ref/SynthyraFoldProtein"],
 ", ",
 ButtonBox["SynthyraFoldComplex",
  BaseStyle->"Link",
  ButtonData->"paclet:Synthyra/SynthyraLink/ref/SynthyraFoldComplex"],
 " \[LongDash] predicted structures as BioMolecule objects, with per-residue \
confidence"
}], "GuideText",
 CellID->169822600,ExpressionUUID->"37a283ff-ca43-b44c-ac51-768ead8254ef"],

Cell[TextData[{
 ButtonBox["SynthyraStructurePlot",
  BaseStyle->"Link",
  ButtonData->"paclet:Synthyra/SynthyraLink/ref/SynthyraStructurePlot"],
 " \[LongDash] 3D structures colored by confidence or by any per-residue \
values"
}], "GuideText",
 CellID->1775728063,ExpressionUUID->"19a2696c-88d4-1641-9e6f-5e7f1a0d2fad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interactions and properties", "GuideFunctionsSubsection",
 CellID->278879824,ExpressionUUID->"db113539-20a5-4441-b9f3-962e5f7bbe63"],

Cell[TextData[{
 ButtonBox["SynthyraProteinInteractionScore",
  BaseStyle->"Link",
  ButtonData->
   "paclet:Synthyra/SynthyraLink/ref/SynthyraProteinInteractionScore"],
 " \[LongDash] the probability that two proteins interact, for single pairs \
or whole sets"
}], "GuideText",
 CellID->1412516262,ExpressionUUID->"2edc1332-91cf-2040-8be3-a3dd1d765140"],

Cell[TextData[{
 ButtonBox["SynthyraLigandBindingScore",
  BaseStyle->"Link",
  ButtonData->"paclet:Synthyra/SynthyraLink/ref/SynthyraLigandBindingScore"],
 " \[LongDash] the probability that a small molecule binds a protein"
}], "GuideText",
 CellID->1248342142,ExpressionUUID->"2123bb7e-2422-5a48-b427-e74b8598eb15"],

Cell[TextData[{
 ButtonBox["SynthyraInteractome",
  BaseStyle->"Link",
  ButtonData->"paclet:Synthyra/SynthyraLink/ref/SynthyraInteractome"],
 " \[LongDash] a protein's predicted partners across its proteome as a Graph, \
with known interactions and enrichment"
}], "GuideText",
 CellID->169829896,ExpressionUUID->"4a24aa55-a9df-244d-aa05-cde98ceaab33"],

Cell[TextData[{
 ButtonBox["SynthyraProteinProperties",
  BaseStyle->"Link",
  ButtonData->"paclet:Synthyra/SynthyraLink/ref/SynthyraProteinProperties"],
 " \[LongDash] predicted solubility, stability, localization, function, and \
more"
}], "GuideText",
 CellID->1579363281,ExpressionUUID->"ac6a457c-6af6-5043-ba51-58cafe731fd2"]
}, Open  ]],

Cell[CellGroupData[{

